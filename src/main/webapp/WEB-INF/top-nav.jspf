

<aside class="sidebar">
  <button class="menu-btn fa fa-chevron-left"></button>
  <a href="${appURL}" class="logo-wrapper">
    <span class="fa-brands fa-uikit"></span>
    <span class="brand-name">THE FIVE BRO'S</span>
  </a>
  <ul class="menu-items">
    <li><a href="${appURL}"><span class="icon fa fa-house"></span><span class="item-name">Home</span></a></li>
    <li><a href="${appURL}/aboutUs"><span class="icon fa fa-layer-group"></span><span class="item-name">About Us</span></a></li>
    <li><a href="${appURL}/store"><span class="icon fa fa-shop"></span><span class="item-name">Store</span></a></li>
    <li><a href="${appURL}/contact"><span class="icon fa fa-phone"></span><span class="item-name">contact</span></a></li>
  </ul>
  <div class="text-end">
    <c:choose>
      <c:when test="${empty sessionScope.activeUser}">
        <ul class="menu-items">
          <li><a href="${appURL}/login"><span class="icon fa fa-sign-in"></span><span class="item-name">Login</span></a></li>
          <li><a href="${appURL}/signup"><span class="icon fa fa-user-plus"></span><span class="item-name">Sign-up</span></a></li>
        </ul>
      </c:when>
      <c:otherwise>
        <ul class="menu-items">
          <li><a href="${appURL}/login"><span class="icon fa fa-sign-out"></span><span class="item-name">Sign Out</span></a></li>
          <li><a href="${appURL}/signup"><span class="icon fa fa-user"></span><span class="item-name">My Profile</span></a></li>
        </ul>
      </c:otherwise>
    </c:choose>
  </div>
</aside>

<!-- Bottom Navigation -->
<div class="bottom-nav">
  <ul>
    <li><a href="${appURL}"><span class="icon fa fa-house"></span></a></li>
    <li><a href="${appURL}/aboutUs"><span class="icon fa fa-layer-group"></span></a></li>
    <li><a href="${appURL}/store"><span class="icon fa fa-shop"></span></a></li>
    <li><a href="${appURL}/contact"><span class="icon fa fa-phone"></span></a></li>
    <c:choose>
      <c:when test="${empty sessionScope.activeUser}">

          <li><a href="${appURL}/login"><span class="icon fa fa-sign-in"></span></a></li>
          <li><a href="${appURL}/signup"><span class="icon fa fa-user-plus"></span></a></li>

      </c:when>
      <c:otherwise>

          <li><a href="${appURL}/login"><span class="icon fa fa-sign-out"></span></a></li>
          <li><a href="${appURL}/signup"><span class="icon fa fa-user"></span></a></li>

      </c:otherwise>
    </c:choose>
  </ul>

