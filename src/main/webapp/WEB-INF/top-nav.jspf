<%--          <li><a href="${appURL}/signup"><span class="icon fa fa-user"></span></a></li>--%>
<%--        </ul>--%>
<%--      </c:otherwise>--%>
<%--    </c:choose>--%>

</div>

<style>
  @import url(https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@400&display=swap);
  @import url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.css);

  body {
    font-family: "Baloo Bhai 2";
    background: #151f29;
    min-height: 100vh;
    color: white;
  }

  :root {
    --menu-width: 300px;
    --collapsed-width: 60px;
  }

  aside {
    display: block;
    padding: 10px;
    position: fixed;
    min-height: 100vh;
    background: linear-gradient(0deg, black, #1f314b);
    width: 300px;
    color: white;
    transition: .3s;
    box-shadow: 0px 0px 15px 0px #00000073;
    z-index: 1;
  }

  .collapsed aside {
    width: var(--collapsed-width);
  }

  .menu-btn {
    color: white;
    position: absolute;
    top: 20px;
    right: 0;
    padding: 8px;
    border: none;
    font-size: 15px;
    aspect-ratio: 1;
    border-radius: 0 50% 50% 0;
    cursor: pointer;
    transform: translateX(100%);
    box-shadow: 2px 0px 5px 0px #1a1a1a;
    background: #1b2b42;
  }

  .logo-wrapper {
    display: flex;
    overflow: hidden;
    white-space: nowrap;
    align-items: center;
    gap: 15px;
    padding: 10px;
  }

  a {
    text-decoration: none;
    color: white;
  }

  .fa-uikit:before {
    font-size: 25px;
  }

  .brand-name {
    font-size: 20px;
    transition: .3s;
  }

  .collapsed .brand-name {
    width: 0;
    visibility: hidden;
    transition-delay: .3s;
  }

  .separator {
    width: 100%;
    height: 1px;
    background-color: rgb(171 171 171 / 21%);
  }

  .menu-items {
    margin-top: 15px;
    padding-left: 0.1rem;
  }

  ul {
    list-style: none;
  }

  .menu-items a {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 10px;
    margin-bottom: 10px;
    overflow: hidden;
  }

  .menu-items a:hover {
    color: #daddff;
    background: #00000017;
    border-radius: 10px;
  }

  .menu-items li {
    position: relative;
  }

  .icon {
    font-size: 20px;
  }

  .item-name {
    transition: .3s;
  }

  .collapsed .item-name {
    width: 0;
    visibility: hidden;
    transition-delay: .3s;
  }

  .tooltip {
    position: absolute;
    right: -25px;
    top: 50%;
    color: white;
    padding: 5px 15px;
    font-size: 15px;
    line-height: 1.5;
    border-radius: 5px;
    opacity: 0;
    visibility: hidden;
    transition: opacity .3s;
    background-color: rgb(22, 22, 22);
    transform: translate(100%, -50%);
  }

  .collapsed .menu-items a:hover+.tooltip {
    visibility: visible;
    opacity: 1;
  }

  .tooltip::before {
    content: "\f0d9";
    font-family: 'Font Awesome 6 Free';
    position: absolute;
    font-weight: 900;
    left: 0;
    top: 50%;
    font-size: 30px;
    color: #161616;
    transform: translate(-50%, -50%);
  }

  main {
    position: relative;
    left: calc(var(--menu-width) + 20px);
    width: calc(100% - (var(--menu-width) + 20px));
    transition: .3s;
    padding: 10px;
    color: white;
  }

  .collapsed main {
    left: calc(var(--collapsed-width) + 20px);
  }
  /* Mobile Styles */
  /* Bottom Navigation Styles */
  .bottom-nav {
    display: none; /* Hidden by default */
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #1b1b1b;
    box-shadow: 0px -3px 6px rgba(0, 0, 0, 0.2);
    z-index: 10; /* Make sure it's on top */
    padding: 10px 0;
  }

  .bottom-nav ul {
    display: flex;
    justify-content: space-around;
    margin: 0;
    list-style: none;
  }

  .bottom-nav li {
    flex: 1;
    text-align: center;
  }

  .bottom-nav a {
    color: #0047ac;
    font-size: 24px;
    text-decoration: none;
    position: relative;
    transition: color 0.3s ease-in-out;
  }


  .bottom-nav a::before {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: #02c6ff;
    transition: width 0.3s ease-in-out, left 0.3s ease-in-out;
  }

  .bottom-nav a:hover {
    color: #02c6ff;
    text-shadow: 0 0 5px #02c6ff, 0 0 10px #02c6ff, 0 0 20px #02c6ff;
    transform: translateY(-5px);
  }

  .bottom-nav a:hover::before {
    width: 100%;
    left: 0;
  }

  /* Responsive Styles */


  /* Ensure the body or main content doesn't push the nav off screen */
  body {
    padding-bottom: 60px; /* Add padding at the bottom to ensure content isn't hidden behind the nav */
  }
  @media (max-width: 768px) {
    .sidebar {
      display: none; /* Hide the sidebar */
    }

    :root {
      --menu-width: 0px; /* Set the menu width to 0 */
    }

    /* Adjust main content to use the full width when sidebar is hidden */
    main {
      left: 0; /* Adjust main content positioning */
      width: 100%; /* Make the main content take up the full width */
    }

    /* Bottom Navigation visibility on small screens */
    .bottom-nav {
      display: block; /* Show the bottom navigation on mobile */
    }
  }


</style>
<script>
  const menuBtn = document.querySelector(".menu-btn");
  menuBtn.addEventListener("click", (e) => {
    document.body.classList.toggle("collapsed");
    e.currentTarget.classList.toggle("fa-chevron-right");
    e.currentTarget.classList.toggle("fa-chevron-left");
  })
</script>
