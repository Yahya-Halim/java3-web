<aside class="sidebar">
  <button class="menu-btn fa fa-chevron-left"></button>
  <a href="${appURL}" class="logo-wrapper">
    <span class="fa-brands fa-uikit"></span>
    <span class="brand-name">THE FIVE BRO'S</span>
  </a>
  <div class="relative px-4 py-3">
    <form id="searchForm" class="relative w-full transition-all duration-300">
      <!-- Search Icon -->
      <button type="button" id="searchToggle"
              class="absolute left-3 top-1/2 -translate-y-1/2 p-1 transition-all duration-300">
        <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700">
          <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor"
                stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <!-- Search Input -->
      <input id="searchBox" type="text"
             class="w-full rounded-full px-10 py-3 border-2 border-transparent focus:outline-none focus:border-blue-500 placeholder-gray-400 transition-all duration-300 shadow-md"
             placeholder="Search..." required />

      <!-- Reset Button -->
      <button type="reset" id="clearSearch"
              class="absolute right-3 top-1/2 -translate-y-1/2 p-1 hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </form>
  </div>
  <ul class="menu-items">
    <li><a href="${appURL}"><span class="icon fa fa-newspaper-o"></span><span class="item-name">home</span></a></li>
    <li><a href="${appURL}/aboutUs"><span class="icon fa fa-layer-group"></span><span class="item-name">About Us</span></a></li>
    <li><a href="${appURL}/post"><span class="icon fa fa-rocket"></span><span class="item-name">Posts</span></a></li>
    <li><a href="${appURL}/connect-four"><span class="icon fa fa-rocket"></span><span class="item-name">Games</span></a></li>

    <li><a href="${appURL}/contact"><span class="icon fa fa-phone"></span><span class="item-name">contact</span></a></li>
    <c:if test="${not empty sessionScope.activeUser && sessionScope.activeUser.status == 'active' && sessionScope.activeUser.privileges == 'admin'}">
      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle icon fa fa-user-shield" href="#" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
        <ul class="dropdown-menu">
          <li><a class="dropdown-item" href="${appURL}/users">All Users</a></li>
          <li><a class="dropdown-item" href="${appURL}/vendors">All Vendors</a></li>
          <li><a class="dropdown-item" href="${appURL}/products">All Products</a></li>
          <li><a class="dropdown-item" href="${appURL}/orders">All Orders</a></li>
        </ul>
      </li>
    </c:if>
    <c:if test="${not empty sessionScope.activeUser && sessionScope.activeUser.status == 'active' && sessionScope.activeUser.privileges == 'premium'}">
      <li><a href="${appURL}/chat"><span class="icon fa fa-users"></span><span class="item-name">Chat</span></a></li>
    </c:if>

  </ul>
  <div class="text-end">
    <c:choose>
      <c:when test="${empty sessionScope.activeUser}">
        <ul class="menu-items">
          <li><a href="${appURL}/login"><span class="icon fa fa-sign-in"></span><span class="item-name">Login</span></a></li>
          <li><a href="${appURL}/signup"><span class="icon fa fa-user-plus"></span><span class="item-name">Sign-up</span></a></li>
        </ul>
      </c:when>
      <c:otherwise>
        <ul class="menu-items">
          <li><a href="${appURL}/signout"><span class="icon fa fa-sign-out"></span><span class="item-name">Sign Out</span></a></li>
          <li><a href="${appURL}/edit-profile"><span class="icon fa fa-user"></span><span class="item-name">Edit Profile</span></a></li>
        </ul>
      </c:otherwise>
    </c:choose>
  </div>
  <!-- Search Box -->



</aside>

<!-- Bottom Navigation -->
<div class="bottom-nav">
  <ul>
    <li><a href="${appURL}"><span class="icon fa fa-house"></span></a></li>
    <li><a href="${appURL}/aboutUs"><span class="icon fa fa-layer-group"></span></a></li>
    <li><a href="${appURL}/store"><span class="icon fa fa-shop"></span></a></li>
    <li><a href="${appURL}/contact"><span class="icon fa fa-phone"></span></a></li>
    <c:if test="${not empty sessionScope.activeUser && sessionScope.activeUser.status == 'active' && sessionScope.activeUser.privileges == 'admin'}">
      <li><a href="${appURL}/users"><span class="icon fa fa-users"></span></a></li>
    </c:if>
    <c:choose>
      <c:when test="${empty sessionScope.activeUser}">

          <li><a href="${appURL}/login"><span class="icon fa fa-sign-in"></span></a></li>
          <li><a href="${appURL}/signup"><span class="icon fa fa-user-plus"></span></a></li>

      </c:when>
      <c:otherwise>

          <li><a href="${appURL}/signout"><span class="icon fa fa-sign-out"></span></a></li>
          <li><a href="${appURL}/edit-profile"><span class="icon fa fa-user"></span></a></li>

      </c:otherwise>
    </c:choose>
  </ul>



</div>

<style>
  @import url(https://fonts.googleapis.com/css2?family=Baloo+Bhai+2:wght@400&display=swap);
  @import url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.css);

  body {
    font-family: "Baloo Bhai 2";
    background: #010f20;
    min-height: 100vh;
    color: white;
  }

  :root {
    --menu-width: 300px;
    --collapsed-width: 60px;
  }

  aside {
    display: block;
    padding: 10px;
    position: fixed;
    min-height: 100vh;
    background: linear-gradient(0deg, #c3ddff, #80adec);
    width: 300px;
    color: white;
    transition: .3s;
    box-shadow: 0px 0px 15px 0px #00000073;
    z-index: 1;
  }

  .collapsed aside {
    width: var(--collapsed-width);
  }

  .menu-btn {
    color: #0b0b0b;
    position: absolute;
    top: 20px;
    right: 0;
    padding: 8px;
    border: none;
    font-size: 15px;
    aspect-ratio: 1;
    border-radius: 0 50% 50% 0;
    cursor: pointer;
    transform: translateX(100%);
    box-shadow: 2px 0px 5px 0px #1a1a1a;
    background: #80adec;
  }

  .logo-wrapper {
    display: flex;
    overflow: hidden;
    white-space: nowrap;
    align-items: center;
    gap: 15px;
    padding: 10px;
  }

  a {
    text-decoration: none;
    color: #0b0b0b;
  }

  .fa-uikit:before {
    font-size: 25px;
  }

  .brand-name {
    font-size: 20px;
    transition: .3s;
  }

  .collapsed .brand-name {
    width: 0;
    visibility: hidden;
    transition-delay: .3s;
  }

  .separator {
    width: 100%;
    height: 1px;
    background-color: rgb(171 171 171 / 21%);
  }

  .menu-items {
    margin-top: 15px;
    padding-left: 0.1rem;
  }

  ul {
    list-style: none;
  }

  .menu-items a {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 10px;
    margin-bottom: 10px;
    overflow: hidden;
    position: relative;
    color: #333; /* Default text color */
    text-decoration: none;
    transition: color 0.3s ease, background-color 0.3s ease;
  }

  .menu-items a::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #007bff; /* Underline color */
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .menu-items a:hover {
    color: #ffffff; /* Text color on hover */
    border-radius: 10px;
  }

  .menu-items a:hover::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-items li {
    position: relative;
  }

  .icon {
    font-size: 20px;
  }

  .item-name {
    transition: .3s;
  }

  .collapsed .item-name {
    width: 0;
    visibility: hidden;
    transition-delay: .3s;
  }

  .tooltip {
    position: absolute;
    right: -25px;
    top: 50%;
    color: white;
    padding: 5px 15px;
    font-size: 15px;
    line-height: 1.5;
    border-radius: 5px;
    opacity: 0;
    visibility: hidden;
    transition: opacity .3s;
    background-color: rgb(22, 22, 22);
    transform: translate(100%, -50%);
  }

  .collapsed .menu-items a:hover+.tooltip {
    visibility: visible;
    opacity: 1;
  }

  .tooltip::before {
    content: "\f0d9";
    font-family: 'Font Awesome 6 Free';
    position: absolute;
    font-weight: 900;
    left: 0;
    top: 50%;
    font-size: 30px;
    color: #161616;
    transform: translate(-50%, -50%);
  }

  main {
    position: relative;
    left: calc(var(--menu-width) + 20px);
    width: calc(100% - (var(--menu-width) + 20px));
    transition: .3s;
    padding: 10px;
    color: white;
  }

  .collapsed main {
    left: calc(var(--collapsed-width) + 20px);
  }
  /* Mobile Styles */
  /* Bottom Navigation Styles */
  .bottom-nav {
    display: none; /* Hidden by default */
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #1b1b1b;
    box-shadow: 0px -3px 6px rgba(0, 0, 0, 0.2);
    z-index: 10000; /* Make sure it's on top */
    padding: 10px 0;
  }

  .bottom-nav ul {
    display: flex;
    justify-content: space-around;
    margin: 0;
    list-style: none;
  }

  .bottom-nav li {
    flex: 1;
    text-align: center;
  }

  .bottom-nav a {
    color: #0047ac;
    font-size: 24px;
    text-decoration: none;
    position: relative;
    transition: color 0.3s ease-in-out;
  }


  .bottom-nav a::before {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: #02c6ff;
    transition: width 0.3s ease-in-out, left 0.3s ease-in-out;
  }

  .bottom-nav a:hover {
    color: #02c6ff;
    text-shadow: 0 0 5px #02c6ff, 0 0 10px #02c6ff, 0 0 20px #02c6ff;
    transform: translateY(-5px);
  }

  .bottom-nav a:hover::before {
    width: 100%;
    left: 0;
  }

  /* Responsive Styles */


  /* Ensure the body or main content doesn't push the nav off screen */
  body {
    padding-bottom: 60px; /* Add padding at the bottom to ensure content isn't hidden behind the nav */
  }
  @media (max-width: 768px) {
    .sidebar {
      display: none; /* Hide the sidebar */
    }

    :root {
      --menu-width: 0px; /* Set the menu width to 0 */
    }

    /* Adjust main content to use the full width when sidebar is hidden */
    main {
      left: 0; /* Adjust main content positioning */
      width: 100%; /* Make the main content take up the full width */
    }

    /* Bottom Navigation visibility on small screens */
    .bottom-nav {
      display: block; /* Show the bottom navigation on mobile */
    }
  }


</style>
<script>
  const menuBtn = document.querySelector(".menu-btn");
  menuBtn.addEventListener("click", (e) => {
    document.body.classList.toggle("collapsed");
    e.currentTarget.classList.toggle("fa-chevron-right");
    e.currentTarget.classList.toggle("fa-chevron-left");
  })
  document.addEventListener("DOMContentLoaded", function () {
    const searchBox = document.getElementById("searchBox");
    const clearSearch = document.getElementById("clearSearch");

    searchBox.addEventListener("input", function () {
      clearSearch.style.display = searchBox.value ? "block" : "none";
    });

    clearSearch.addEventListener("click", function () {
      searchBox.value = "";
      clearSearch.style.display = "none";
    });
  });
</script>
