<!-- Centered Search Bar -->
<div class="container mt-4 d-flex justify-content-center">
    <div class="position-relative w-100" style="max-width: 600px;">
        <form id="searchForm" method="get" action="${appURL}/search">
            <!-- Search Icon -->
            <button type="submit" class="position-absolute start-0 top-50 translate-middle-y px-3 border-0 bg-transparent">
                <i class="bi bi-search text-secondary"></i>
            </button>

            <!-- Search Input -->
            <input id="searchBox" type="text" name="query"
                   class="form-control rounded-pill ps-5 pe-5 py-2 shadow-sm"
                   placeholder="Search..." required />

            <!-- Clear Button -->
            <button type="reset" id="clearSearch"
                    class="position-absolute end-0 top-50 translate-middle-y px-3 border-0 bg-transparent d-none">
                <i class="bi bi-x-circle text-secondary"></i>
            </button>
        </form>
    </div>
</div>
<c:if test="${totalPages gt 1}">
<nav aria-label="...">
    <ul class="pagination">
        <c:if test="${page gt 1}">
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=1"><i class="bi bi-chevron-double-left"></i></a>
        </li>
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=${page - 1}"><i class="bi bi-chevron-left"></i></a>
        </li>
        </c:if>
        <c:forEach var="i" begin="${beginPage}" end="${endPage}">
        <li class="page-item <c:if test="${page eq i}">active</c:if>" <c:if test="${page eq i}">aria-current="page"</c:if>>
            <a class="page-link" href="${appURL}/shop?page=${i}">${i}</a>
        </li>
        </c:forEach>
        <c:if test="${page lt totalPages}">
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=${page + 1}"><i class="bi bi-chevron-right"></i></a>
        </li>
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=${totalPages}"><i class="bi bi-chevron-double-right"></i></a>
        </li>
        </c:if>
    </ul>
</nav>
</c:if>