<%-- Build queryParams to retain filters across pagination --%>
<c:set var="queryParams" value="&search=${fn:escapeXml(param.search)}&minPrice=${param.minPrice}&maxPrice=${param.maxPrice}&sort=${param.sort}&limit=${param.limit}" />
<c:forEach var="cat" items="${paramValues.categories}">
    <c:set var="queryParams" value="${queryParams}&categories=${cat}" />
</c:forEach>

<c:if test="${totalPages gt 1}">
<nav aria-label="...">
    <ul class="pagination">
        <c:if test="${page gt 1}">
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=1${queryParams}"><i class="bi bi-chevron-double-left"></i></a>
        </li>
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=${page - 1}${queryParams}"><i class="bi bi-chevron-left"></i></a>
        </li>
        </c:if>
        <c:forEach var="i" begin="${beginPage}" end="${endPage}">
        <li class="page-item <c:if test='${page eq i}'>active</c:if>'" <c:if test="${page eq i}">aria-current="page"</c:if>>
            <a class="page-link" href="${appURL}/shop?page=${i}${queryParams}">${i}</a>
        </li>
        </c:forEach>
        <c:if test="${page lt totalPages}">
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=${page + 1}${queryParams}"><i class="bi bi-chevron-right"></i></a>
        </li>
        <li class="page-item">
            <a class="page-link" href="${appURL}/shop?page=${totalPages}${queryParams}"><i class="bi bi-chevron-double-right"></i></a>
        </li>
        </c:if>
    </ul>
</nav>
</c:if>
