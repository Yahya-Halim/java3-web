<jsp:useBean id="calendar" class="java.util.GregorianCalendar" scope="page" />
<%
    // Assuming userLocalTime is set as request attribute or session attribute
    java.util.Date userLocalTime = (java.util.Date) request.getAttribute("userLocalTime");
    if (userLocalTime != null) {
        calendar.setTime(userLocalTime);
    } else {
        calendar.setTime(new java.util.Date()); // Fallback to current server time
    }
    int hour = calendar.get(java.util.Calendar.HOUR_OF_DAY);
    request.setAttribute("userHour", hour);
%>
<section class="my-4">
    <div class="container mx-auto px-4">
        <div class="flex flex-wrap">
            <!-- Profile banner START -->
            <div class="w-full">
                <div class="bg-gray-100 p-6 rounded-lg shadow-sm">
                    <!-- Profile info -->
                    <div class="flex justify-between items-center">
                        <div>
                            <jsp:useBean id="now" class="java.util.Date" scope="page" />
                            <c:choose>
                                <c:when test="${userHour lt 12}">
                                    <h4 class="text-2xl font-semibold text-black">Good morning<c:if test="${not empty activeUser.firstName}">, ${fn:escapeXml(activeUser.firstName)}</c:if>!</h4>
                                </c:when>
                                <c:when test="${userHour lt 18}">
                                    <h4 class="text-2xl font-semibold text-black">Good afternoon<c:if test="${not empty activeUser.firstName}">, ${fn:escapeXml(activeUser.firstName)}</c:if>!</h4>
                                </c:when>
                                <c:otherwise>
                                    <h4 class="text-2xl font-semibold text-black">Good evening<c:if test="${not empty activeUser.firstName}">, ${fn:escapeXml(activeUser.firstName)}</c:if>!</h4>
                                </c:otherwise>
                            </c:choose>
                            <ul class="list-none space-y-1 mt-2">
                                <li class="list-item text-black">
                                    <i class="bi bi-calendar-event-fill fs-6"></i> Today is <fmt:formatDate value="${now}" pattern="MMMM d, YYYY h:mm a z" timeZone="${activeUser.timezone}" />
                                </li>
                                <li class="flex items-center text-black-700">
                                    <i class="bi bi-star-fill text-lg mr-2 text-black"> Member since <fmt:formatDate value="${activeUser.createdAtDate}" dateStyle="long" /></i>
                                </li>
                            </ul>
                        </div>
                        <!-- Responsive toggler START -->
                        <button class="lg:hidden bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar" aria-controls="offcanvasSidebar">
                            <i class="bi bi-list text-xl"></i>
                        </button>
                        <!-- Responsive toggler END -->
                    </div>
                </div>
            </div>
            <!-- Profile banner END -->
        </div>
    </div>
</section>
