<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@taglib prefix="fn" uri="jakarta.tags.functions"%>
<%@ taglib prefix="cfn" uri="/WEB-INF/tld/custom-functions.tld" %>
<%@ taglib prefix="cfmt" uri="/WEB-INF/tld/custom-formats.tld" %>
<jsp:useBean id="date"  class="java.util.Date"/>

<c:choose>
    <c:when test="${not empty param.lang}">
        <c:set var="language" value="${param.lang}" scope="session" />
    </c:when>
    <c:when test="${not empty activeUser.language}">
        <c:set var="language" value="${activeUser.language}" scope="session" />
    </c:when>
    <c:when test="${not empty sessionScope.language}">
        <c:set var="language" value="${sessionScope.language}" scope="session" />
    </c:when>
    <c:otherwise>
        <c:set var="language" value="en" scope="session" />
    </c:otherwise>
</c:choose>

<fmt:setLocale value="${language}" />
<fmt:setBundle basename="a18y" />
<c:choose>
  <c:when test="${pageContext.request.serverName eq 'localhost'}">
    <%-- Do something on localhost only --%>
    <c:set var="appURL" value="${initParam['appURLLocal']}"></c:set>
  </c:when>
  <c:otherwise>
    <%-- Do something on Azure only --%>
    <c:set var="appURL" value="${initParam['appURLCloud']}"></c:set>
  </c:otherwise>
</c:choose>
<!doctype html>
<html lang="${language}" <c:if test="${language eq 'ar'}">dir="rtl"</c:if>  >
  <c:choose>
        <c:when test="${language eq 'ar'}">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.rtl.min.css" integrity="sha384-q8+l9TmX3RaSz3HKGBmqP2u5MkgeN7HrfOJBLcTgZsQsbrx8WqqxdA5PuwUV9WIx" crossorigin="anonymous">
        </c:when>
        <c:otherwise>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
                  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        </c:otherwise>
    </c:choose>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="${appURL}/styles/home.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


<%--  Additional CSS  --%>

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
          crossorigin="anonymous"></script>
  <script defer src="https://code.jquery.com/jquery-3.7.1.min.js"
          integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
          crossorigin="anonymous"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <c:if test="${pageTitle eq 'Signup for an account'}">
  <script src="https://www.google.com/recaptcha/enterprise.js?render=6LfRe9oqAAAAAIOxxur3EtZjGRmq82ue8jmkTXPK" async defer></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    grecaptcha.enterprise.ready(function() {
      grecaptcha.enterprise.execute('6LfRe9oqAAAAAIOxxur3EtZjGRmq82ue8jmkTXPK', {action: 'signup'}).then(function(token) {
        // Add token to a hidden input in your form
        var recaptchaResponse = document.createElement('input');
        recaptchaResponse.setAttribute('type', 'hidden');
        recaptchaResponse.setAttribute('name', 'recaptcha_token');
        recaptchaResponse.setAttribute('value', token);
        document.forms[0].appendChild(recaptchaResponse);
      });
    });
  </script>


  </c:if>

  <c:if test="${pageTitle eq 'Login'}"><script src="${appURL}/scripts/remember-me.js"></script></c:if>
  <c:if test="${pageTitle eq 'chat'}"><script src="${appURL}/scripts/group-chat.js"></script></c:if>



<%--  Additional JavaScript  --%>
</head>
<body>
<%@ include file="/WEB-INF/top-nav.jspf"%>
<main class="flex-1 transition-all duration-300 ease-in-out">
  <div class="container">
    <c:choose>
      <c:when test="${not empty sessionScope.flashMessageSuccess}">
        <div class="alert alert-success my-2" role="alert">${fn:escapeXml(sessionScope.flashMessageSuccess)}</div>
        <c:remove var="flashMessageSuccess" scope="session"></c:remove>
      </c:when>
      <c:when test="${not empty sessionScope.flashMessageDanger}">
        <div class="alert alert-danger my-2" role="alert">${fn:escapeXml(sessionScope.flashMessageDanger)}</div>
        <c:remove var="flashMessageDanger" scope="session"></c:remove>
      </c:when>
      <c:when test="${not empty sessionScope.flashMessageWarning}">
        <div class="alert alert-warning my-2" role="alert">${fn:escapeXml(sessionScope.flashMessageWarning)}</div>
        <c:remove var="flashMessageWarning" scope="session"></c:remove>
      </c:when>
    </c:choose>






  </div>
  <div class="container mt-3">
  <div class="d-flex justify-content-end">
    <a href="${appURL}/cart" class="btn btn-primary">
      <i class="bi bi-cart"></i>
      ${cart.totalProductCount}
      <c:if test="${not empty cart}">, </c:if>
      ${cart.totalPrice}
    </a>


  </div>
</div>

</main>
</body>
</html>
