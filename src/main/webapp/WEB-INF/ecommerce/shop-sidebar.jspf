<!-- Button to Show Sidebar -->
<button onclick="toggleSidebar()" class="w-40 h-10 fixed right-6 top-60 transform -translate-y-1/2 bg-green-500 text-white text-sm px-4 py-2 rounded-full shadow-lg hover:bg-blue-600 focus:outline-none z-50">
    Show Filters
</button>

<!-- Right Sidebar START -->
<div id="sidebar" class="fixed  right-0 w-1/4 h-100 bg-white shadow-lg p-4 z-50 hidden rounded-50">
    <!-- Sidebar Header -->
    <div class="flex justify-between items-center mb-4">
        <h5 class="text-lg font-semibold text-gray-800">Advanced Filter</h5>
        <button class="text-gray-500 hover:text-gray-800" onclick="toggleSidebar()">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <form method="GET" action="${appURL}/shop">
        <!-- Search Box -->
        <div class="relative mb-4">
            <input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" name="search" id="filter-${name}" placeholder="Search for products..." value="${param.search}">
            <button type="submit" class="absolute right-4 top-2.5 text-blue-500">
                <i class="bi bi-search"></i>
            </button>
        </div>

        <!-- Category Filter -->
        <div class="mb-4">
            <h4 class="text-sm font-semibold text-gray-800">Category</h4>
            <div class="space-y-2">
                <c:forEach var="category" items="${productCategories}">
                    <div class="flex items-center space-x-2">
                        <input type="checkbox" class="h-4 w-4 text-blue-500 border-gray-300 rounded" id="filter-${category.id}" name="categories" value="${category.id}"
                               <c:if test="${fn:contains(categories, category.id)}">checked</c:if>>
                        <label class="text-gray-700 text-sm" for="filter-${category.id}">
                            ${category.name} (${category.numProducts})
                        </label>
                    </div>
                </c:forEach>
            </div>
        </div>

        <!-- Price Range Filter -->
        <div class="mb-4">
            <h4 class="text-sm font-semibold text-gray-800">Price Range</h4>
            <div class="space-y-3">
                <div>
                    <label for="minPrice" class="text-xs text-gray-600">Min Price</label>
                    <input type="number" step="0.01" class="w-full px-4 py-2 text-black border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" id="minPrice" name="minPrice" value="${minPrice}">
                </div>
                <div>
                    <label for="maxPrice" class="text-xs text-gray-600">Max Price</label>
                    <input type="number" step="0.01" class="w-full px-4 py-2 text-black border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" id="maxPrice" name="maxPrice" value="${maxPrice}">
                </div>
            </div>
        </div>

        <!-- Sort By Filter -->
        <div class="mb-4">
            <h4 class="text-sm font-semibold text-gray-800">Sort By</h4>
            <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" name="sort">
                <option value="">-- Select --</option>
                <option value="az" <c:if test="${sort eq 'az'}">selected</c:if>>Name: A to Z</option>
                <option value="za" <c:if test="${sort eq 'za'}">selected</c:if>>Name: Z to A</option>
            </select>
        </div>

        <!-- Limit START -->
        <div class="card card-body shadow p-4 mb-4">
            <h4 class="mb-2 text-black">Show</h4>
            <div class="btn-group" role="group" aria-label="Show radio toggle button group">
                <input type="radio" class="btn-check" id="show-5" autocomplete="off" name="limit" value="5" <c:if test="${limit eq 5}">checked</c:if>>
                <label class="btn btn-outline-success" for="show-5">5</label>
                <input type="radio" class="btn-check" id="show-10" autocomplete="off" name="limit" value="10" <c:if test="${limit eq 10}">checked</c:if>>
                <label class="btn btn-outline-success" for="show-10">10</label>
                <input type="radio" class="btn-check" id="show-20" autocomplete="off" name="limit" value="20" <c:if test="${limit eq 20}">checked</c:if>>
                <label class="btn btn-outline-success" for="show-20">20</label>
            </div>
        </div>
        <!-- Limit END -->

        <!-- Submit Button -->
        <div class="mt-4 text-center">
            <button type="submit" class="w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 focus:outline-none">
                Filter Results
            </button>
        </div>
    </form>
</div>
<!-- Right Sidebar END -->

<!-- Tailwind CSS Modal (Offcanvas) -->
<script>
    // Function to toggle sidebar visibility
    const toggleSidebar = () => {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('hidden');
    };
</script>
