<!-- Button to Show Sidebar -->
<button onclick="toggleSidebar()"
        class="fixed h-10 w-40 right-20 top-60 md:right-20 md:top-6 bg-green-500 text-white text-sm px-4 py-2 rounded-full shadow-lg hover:bg-blue-600 focus:outline-none z-50">
    Show Filters
</button>

<!-- Overlay -->
<div id="overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden" onclick="toggleSidebar()"></div>

<!-- Right Sidebar START -->
<div id="sidebar"
    class="fixed top-0 right-0 h-full w-full sm:w-3/4 md:w-2/5 lg:w-1/4 bg-white shadow-lg p-6 z-50 hidden overflow-y-auto rounded-none sm:rounded-l-2xl transition-transform duration-300">

    <!-- Sidebar Header -->
    <div class="flex justify-between items-center mb-4">
        <h5 class="text-lg font-semibold text-gray-800">Advanced Filter</h5>
        <button class="text-gray-500 hover:text-gray-800" onclick="toggleSidebar()">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Filter Form -->
    <form method="GET" action="${appURL}/shop">
        <c:set var="selectedCategories" value="${paramValues.categories}" />

        <!-- Search Box -->
        <div class="relative mb-4">
            <input type="text"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg text-black focus:outline-none focus:ring-2 focus:ring-blue-500"
                   name="search"
                   id="filter-search"
                   placeholder="Search for products..."
                   value="${param.search}">
            <button type="submit" class="absolute right-4 top-2.5 text-blue-500">
                <i class="bi bi-search"></i>
            </button>
        </div>

        <!-- Category Filter -->
        <div class="mb-4">
            <h4 class="text-sm font-semibold text-gray-800">Category</h4>
            <div class="space-y-2">
                <c:forEach var="category" items="${productCategories}">
                    <div class="flex items-center space-x-2">
                         <input class="form-check-input" type="checkbox" id="filter-${category.id}" name="categories" value="${category.id}" <c:if test="${cfn:contains(categoriesArr, category.id)}">checked</c:if>>
                        <label class="text-gray-700 text-sm" for="filter-${category.id}">
                            ${category.name} (${category.numProducts})
                        </label>
                    </div>
                </c:forEach>
            </div>
        </div>

        <!-- Price Range Filter -->
        <div class="mb-4">
            <h4 class="text-sm font-semibold text-gray-800">Price Range</h4>
            <div class="space-y-3">
                <div>
                    <label for="minPrice" class="text-xs text-gray-600">Min Price</label>
                    <input type="number"
                           step="0.01"
                           class="w-full px-4 py-2 text-black border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                           id="minPrice"
                           name="minPrice"
                           value="${param.minPrice}">
                </div>
                <div>
                    <label for="maxPrice" class="text-xs text-gray-600">Max Price</label>
                    <input type="number"
                           step="0.01"
                           class="w-full px-4 py-2 text-black border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                           id="maxPrice"
                           name="maxPrice"
                           value="${param.maxPrice}">
                </div>
            </div>
        </div>

        <!-- Sort By Filter -->
        <div class="mb-4">
            <h4 class="text-sm font-semibold text-gray-800">Sort By</h4>
            <select class="w-full px-4 py-2 border border-gray-300 rounded-lg text-black focus:outline-none focus:ring-2 focus:ring-blue-500" name="sort">
                <option value="">-- Select --</option>
                <option value="az" <c:if test="${param.sort eq 'az'}">selected</c:if>>Name: A to Z</option>
                <option value="za" <c:if test="${param.sort eq 'za'}">selected</c:if>>Name: Z to A</option>
            </select>
        </div>

        <!-- Limit Filter -->
        <div class="card card-body shadow p-4 mb-4">
            <h4 class="mb-2 text-black">Show</h4>
            <div class="btn-group" role="group" aria-label="Show radio toggle button group">
                <input type="radio" class="btn-check" id="show-5" name="limit" value="5" <c:if test="${param.limit eq '5'}">checked</c:if>>
                <label class="btn btn-outline-success" for="show-5">5</label>

                <input type="radio" class="btn-check" id="show-10" name="limit" value="10" <c:if test="${param.limit eq '10'}">checked</c:if>>
                <label class="btn btn-outline-success" for="show-10">10</label>

                <input type="radio" class="btn-check" id="show-20" name="limit" value="20" <c:if test="${param.limit eq '20'}">checked</c:if>>
                <label class="btn btn-outline-success" for="show-20">20</label>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="mt-4 text-center">
            <button type="submit" class="w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 focus:outline-none">
                Filter Results
            </button>
        </div>
    </form>
</div>
<!-- Right Sidebar END -->

<!-- Toggle Logic -->
<script>
    const toggleSidebar = () => {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');

        const isHidden = sidebar.classList.contains('hidden');

        if (isHidden) {
            sidebar.classList.remove('hidden');
            overlay.classList.remove('hidden');
        } else {
            sidebar.classList.add('hidden');
            overlay.classList.add('hidden');
        }
    };
</script>
